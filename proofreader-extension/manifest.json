{
  "manifest_version": 3,
  "name": "Test Proofreader",
  "version": "1.0.0",
  "description": "Scroll a test or quiz page once: flags spelling, duplicate, calculation and question problems so you can correct them.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["https://api.anthropic.com/*"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Test Proofreader",
    "default_icon": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" }
  },
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" },
  "commands": {
    "_execute_action": { "suggested_key": { "default": "Alt+Shift+P" } }
  }
}
