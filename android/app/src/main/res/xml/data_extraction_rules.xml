<?xml version="1.0" encoding="utf-8"?>
<!-- A sharing session is deliberately not worth backing up: keys are one-off
     and a restored session would be a link nobody expects to be live. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
    </device-transfer>
</data-extraction-rules>
