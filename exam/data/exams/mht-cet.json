  "questions": [
    {
      "id": "mht-cet-001",
      "section": "physics",
      "topic": "Rotational Dynamics",
      "difficulty": "easy",
      "question": "A horizontal disc rotates freely about its vertical axis at 30 rpm. An identical disc, initially at rest, is gently placed coaxially on it and both rotate together. The common angular speed is",
      "options": [
        "30 rpm",
        "7.5 rpm",
        "60 rpm",
        "15 rpm"
      ],
      "answer": 3,
      "explanation": "Angular momentum is conserved: Iω = 2Iω' ⇒ ω' = 15 rpm.",
      "verified": true
    },
    {
      "id": "mht-cet-002",
      "section": "physics",
      "topic": "Rotational Dynamics",
      "difficulty": "easy",
      "question": "The radius of gyration of a solid sphere of radius R about any diameter is",
      "options": [
        "√(2/3) R",
        "R/√2",
        "√(2/5) R",
        "R"
      ],
      "answer": 2,
      "explanation": "I = (2/5)MR² = MK² ⇒ K = √(2/5) R.",
      "verified": true
    },
    {
      "id": "mht-cet-003",
      "section": "physics",
      "topic": "Rotational Dynamics",
      "difficulty": "medium",
      "question": "A road of radius 50 m is banked such that tan θ = 0.2. The speed at which a vehicle can negotiate the curve without relying on friction is (g = 10 m/s²)",
      "options": [
        "5 m/s",
        "20 m/s",
        "100 m/s",
        "10 m/s"
      ],
      "answer": 3,
      "explanation": "v = √(rg tan θ) = √(50 × 10 × 0.2) = √100 = 10 m/s.",
      "verified": true
    },
    {
      "id": "mht-cet-004",
      "section": "physics",
      "topic": "Mechanical Properties of Fluids",
      "difficulty": "medium",
      "question": "Eight identical rain drops, each falling with terminal velocity v, coalesce into one big drop. The terminal velocity of the big drop is",
      "options": [
        "2v",
        "4v",
        "8v",
        "v"
      ],
      "answer": 1,
      "explanation": "Volume conserved: R³ = 8r³ ⇒ R = 2r. Terminal velocity ∝ r², so v' = 4v.",
      "verified": true
    },
    {
      "id": "mht-cet-005",
      "section": "physics",
      "topic": "Mechanical Properties of Fluids",
      "difficulty": "easy",
      "question": "The excess pressure inside a soap bubble of radius 1 cm (surface tension 0.03 N/m) is",
      "options": [
        "12 Pa",
        "6 Pa",
        "3 Pa",
        "24 Pa"
      ],
      "answer": 0,
      "explanation": "A soap bubble has two surfaces: ΔP = 4T/r = 4 × 0.03/0.01 = 12 Pa.",
      "verified": true
    },
    {
      "id": "mht-cet-006",
      "section": "physics",
      "topic": "Kinetic Theory of Gases & Radiation",
      "difficulty": "easy",
      "question": "If the absolute temperature of a black body is doubled, the total power it radiates becomes",
      "options": [
        "4 times",
        "8 times",
        "16 times",
        "2 times"
      ],
      "answer": 2,
      "explanation": "Stefan–Boltzmann law: P ∝ T⁴ ⇒ 2⁴ = 16.",
      "verified": true
    },
    {
      "id": "mht-cet-007",
      "section": "physics",
      "topic": "Thermodynamics",
      "difficulty": "hard",
      "question": "A diatomic ideal gas (γ = 1.4) at 300 K is compressed adiabatically to 1/32 of its initial volume. Its final temperature is",
      "options": [
        "600 K",
        "2400 K",
        "9600 K",
        "1200 K"
      ],
      "answer": 3,
      "explanation": "TV^(γ−1) = constant ⇒ T₂ = 300 × 32^0.4 = 300 × 2² = 1200 K (since 32^0.4 = 2^(5×0.4) = 4).",
      "verified": true
    },
    {
      "id": "mht-cet-008",
      "section": "physics",
      "topic": "Oscillations",
      "difficulty": "medium",
      "question": "A mass on a spring oscillates with period T. If it is instead attached to two such identical springs connected in series, the period becomes",
      "options": [
        "T/√2",
        "2T",
        "T/2",
        "√2 T"
      ],
      "answer": 3,
      "explanation": "Series: k_eff = k/2. T ∝ 1/√k ⇒ T' = √2 T.",
      "verified": true
    },
    {
      "id": "mht-cet-009",
      "section": "physics",
      "topic": "Superposition of Waves",
      "difficulty": "medium",
      "question": "Tuning fork A (256 Hz) produces 4 beats per second with fork B. When B is loaded with a little wax, the beat frequency increases to 6 per second. The original frequency of B was",
      "options": [
        "260 Hz",
        "252 Hz",
        "250 Hz",
        "262 Hz"
      ],
      "answer": 1,
      "explanation": "B is 252 or 260 Hz. Loading lowers B's frequency; beats increase only if B was below A: 252 → lower gives more beats. So B = 252 Hz.",
      "verified": true
    },
    {
      "id": "mht-cet-010",
      "section": "physics",
      "topic": "Wave Optics",
      "difficulty": "medium",
      "question": "Light of wavelength 600 nm falls normally on a single slit of width 0.3 mm. The width of the central maximum on a screen 2 m away is",
      "options": [
        "4 mm",
        "2 mm",
        "8 mm",
        "16 mm"
      ],
      "answer": 2,
      "explanation": "Width = 2λD/a = 2 × 600×10⁻⁹ × 2/(0.3×10⁻³) = 8 × 10⁻³ m = 8 mm.",
      "verified": true
    },
    {
      "id": "mht-cet-011",
      "section": "physics",
      "topic": "Wave Optics",
      "difficulty": "easy",
      "question": "The Brewster angle for a transparent medium of refractive index √3 is",
      "options": [
        "60°",
        "30°",
        "45°",
        "90°"
      ],
      "answer": 0,
      "explanation": "tan i_p = μ = √3 ⇒ i_p = 60°.",
      "verified": true
    },
    {
      "id": "mht-cet-012",
      "section": "physics",
      "topic": "Electrostatics",
      "difficulty": "easy",
      "question": "Three capacitors of 2 μF, 3 μF and 6 μF are connected in series. The equivalent capacitance is",
      "options": [
        "11 μF",
        "1 μF",
        "2 μF",
        "0.5 μF"
      ],
      "answer": 1,
      "explanation": "1/C = 1/2 + 1/3 + 1/6 = 1 ⇒ C = 1 μF.",
      "verified": true
    },
    {
      "id": "mht-cet-013",
      "section": "physics",
      "topic": "Current Electricity",
      "difficulty": "medium",
      "question": "A uniform potentiometer wire 10 m long has a steady potential difference of 2 V across it. The balancing length for a cell of emf 1.5 V is",
      "options": [
        "5 m",
        "6.67 m",
        "7.5 m",
        "3.75 m"
      ],
      "answer": 2,
      "explanation": "Potential gradient = 2/10 = 0.2 V/m. Balancing length = 1.5/0.2 = 7.5 m.",
      "verified": true
    },
    {
      "id": "mht-cet-014",
      "section": "physics",
      "topic": "Magnetic Fields due to Electric Current",
      "difficulty": "easy",
      "question": "Two long parallel wires 1 m apart in vacuum each carry a current of 1 A. The force per metre length between them is",
      "options": [
        "1 × 10⁻⁷ N",
        "2 × 10⁻⁷ N",
        "4π × 10⁻⁷ N",
        "2π × 10⁻⁷ N"
      ],
      "answer": 1,
      "explanation": "F/l = μ₀I₁I₂/(2πd) = 4π×10⁻⁷ × 1 × 1/(2π × 1) = 2 × 10⁻⁷ N/m (the definition of the ampere).",
      "verified": true
    },
    {
      "id": "mht-cet-015",
      "section": "physics",
      "topic": "Electromagnetic Induction",
      "difficulty": "medium",
      "question": "A coil of 500 turns and area 0.01 m² is held perpendicular to a magnetic field that decreases uniformly from 0.2 T to zero in 0.1 s. The magnitude of the induced emf is",
      "options": [
        "1 V",
        "5 V",
        "100 V",
        "10 V"
      ],
      "answer": 3,
      "explanation": "e = N A ΔB/Δt = 500 × 0.01 × 0.2/0.1 = 10 V.",
      "verified": true
    },
    {
      "id": "mht-cet-016",
      "section": "physics",
      "topic": "AC Circuits",
      "difficulty": "hard",
      "question": "A series LCR circuit has L = 2 H, C = 2 μF and R = 10 Ω. The quality factor of the circuit at resonance is",
      "options": [
        "10",
        "1000",
        "100",
        "50"
      ],
      "answer": 2,
      "explanation": "Q = (1/R)√(L/C) = (1/10)√(2/(2×10⁻⁶)) = (1/10) × 1000 = 100.",
